# 이 파일을 복사해서 .env 로 이름을 바꾸고 값을 채우세요. (.env는 GitHub에 안 올라가요)

# 시세: naver(실제 시세, 키 필요 없음) 또는 demo(연습용 가짜 시세)
MARKET_SOURCE=naver

# AI 코치. 키를 비워 두면 '규칙 코치'가 대신 말해요.
LLM_PROVIDER=gemini
LLM_API_KEY=
# LLM_MODEL=gemini-flash-latest  (비워 두면 이 값)

# Groq를 쓰려면:
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
